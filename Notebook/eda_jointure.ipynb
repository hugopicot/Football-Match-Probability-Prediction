    "y = data[\"resultat\"]\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)\n",
    "\n",
    "modele = LogisticRegression(max_iter=1000)\n",
    "modele.fit(X_train, y_train)\n",
    "\n",
    "resultats_test = pd.DataFrame({\n",
    "    \"bonnes predictions_pct\": [\n",
    "        100 * (prediction(X_test[\"home_5\"], X_test[\"away_5\"]) == y_test).mean(),\n",
    "        100 * (prediction(X_test[\"home_610\"], X_test[\"away_610\"]) == y_test).mean(),\n",
    "        100 * modele.score(X_test, y_test),\n",
    "        100 * (y_test == \"home\").mean(),\n",
    "    ]\n",
    "}, index=[\n",
    "    \"Brute (matchs 1 à 5)\",\n",
    "    \"Habituelle (matchs 6 à 10)\",\n",
    "    \"Modèle entraîné (70 %)\",\n",
    "    \"Toujours domicile\",\n",
    "])\n",
    "print(f\"Modèle entraîné sur {len(X_train):,} matchs, testé sur {len(X_test):,} matchs.\")\n",
