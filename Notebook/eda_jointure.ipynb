    "import numpy as np\n",
    "\n",
    "def total_points(prenom, debut, fin):\n",
    "    \"\"\"Points cumulés (3 victoire, 1 nul, 0 défaite) sur les matchs d'index debut à fin.\"\"\"\n",
    "    total = pd.Series(0.0, index=eda.index)\n",
    "    matchs = pd.Series(0, index=eda.index)\n",
    "    for i in range(debut, fin + 1):\n",
    "        buts = eda[f\"{prenom}_history_goal_{i}\"]\n",
    "        contre = eda[f\"{prenom}_history_opponent_goal_{i}\"]\n",
    "        valide = buts.notna() & contre.notna()\n",
    "        points = np.where(buts > contre, 3.0, np.where(buts == contre, 1.0, 0.0))\n",
    "        total = total + np.where(valide, points, 0.0)\n",
    "        matchs = matchs + valide.astype(int)\n",
    "    return total, matchs\n",
    "\n",
    "data = pd.DataFrame({\"resultat\": eda[\"target\"]}, index=eda.index)\n",
    "data[\"home_5\"], n_home_5 = total_points(\"home_team\", 1, 5)\n",
    "data[\"away_5\"], n_away_5 = total_points(\"away_team\", 1, 5)\n",
    "data[\"home_610\"], n_home_610 = total_points(\"home_team\", 6, 10)\n",
    "data[\"away_610\"], n_away_610 = total_points(\"away_team\", 6, 10)\n",
    "\n",
    "garde = (\n",
    "    (n_home_5 >= 3) & (n_away_5 >= 3)\n",
    "    & (n_home_610 >= 3) & (n_away_610 >= 3)\n",
    "    & data[\"resultat\"].notna()\n",
    ")\n",
    "data = data[garde].copy()\n",
    "\n",
    "print(f\"{len(data):,} matchs analysés.\")\n",
    "data.head()\n"
   ]
  },
